# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). The anon key is safe to expose in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public landing-page link to a published composition, for example /c/<id>.
VITE_PUBLIC_DEMO_URL=

# Server-side env vars for the Netlify sign-in function (no VITE_ prefix —
# these are never inlined into the client bundle).
# Copy values from your Supabase project (same as the VITE_ vars above).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated list of email addresses allowed to sign in as creators.
# Leave unset to allow any email address.
ALLOWED_EMAILS=
